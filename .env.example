# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Meta / Facebook ───────────────────────────────────────────────────────────
# Get from https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Long-lived Page Access Token (valid 60 days – refresh monthly)
META_ACCESS_TOKEN=
# Your Ad Account ID (format: act_XXXXXXXXXX)  found in Business Manager
META_AD_ACCOUNT_ID=
# Webhook verify token – set any random string, then paste same in Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=viakashmir_webhook_secret_2024

# ── Google Ads ────────────────────────────────────────────────────────────────
# Developer Token from https://ads.google.com/nav/selectaccount → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth2 credentials from https://console.cloud.google.com → APIs → Credentials
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token generated during OAuth2 flow
GOOGLE_ADS_REFRESH_TOKEN=
# Your Google Ads Customer ID (format: XXX-XXX-XXXX, without dashes: XXXXXXXXXX)
GOOGLE_ADS_CUSTOMER_ID=

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/leads.db

# ── Sync Interval ────────────────────────────────────────────────────────────
# Cron expression – default: every 15 minutes
SYNC_CRON=*/15 * * * *
